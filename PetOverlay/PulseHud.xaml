<Window x:Class="PetOverlay.PulseHud"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulse"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border Background="#1E1E22" CornerRadius="14" Padding="14,11" BorderBrush="#46464E" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        <StackPanel MinWidth="270">
            <Grid Margin="0,0,0,9">
                <TextBlock Text="Pulse" Foreground="#E8E8EE" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="AgeText" Foreground="#6E6E78" FontSize="10"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border x:Name="CloseButton" Width="18" Height="18" CornerRadius="9"
                            Background="Transparent" Cursor="Hand" ToolTip="Close">
                        <TextBlock x:Name="CloseGlyph" Text="&#x2715;" FontSize="9" Foreground="#8A8A96"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="RowsPanel"/>
            <TextBlock x:Name="FooterText" Foreground="#8A8A96" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
