<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PetOverlay</AssemblyName>
    <!-- WPF's TextBox needs real culture/input-language data for caret handling -
         invariant mode throws CultureNotFoundException the moment one renders
         (hit via the ask_user "text" kind and the radial menu's Prompt override). -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF + UseWindowsForms both implicitly global-`using` their root namespace,
         which collide on Application/Button/TextBox/etc. We only need a handful of
         WinForms types (NotifyIcon, Screen) and reference those via an explicit
         `Forms.` alias instead, so drop the implicit global using. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every skin (including the default look) lives under claudy\skins\<name>\,
         and icons are split by domain (menu\ vs emoji\) - both recursive globs. -->
    <Content Include="Assets\claudy\skins\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\toys\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\icons\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
